@media (max-width: 991px) {
  .card,a.bordered-btn {
    margin: auto;
  }

  a.boxed-btn,a.bordered-btn {
    width: 50%;
    margin-bottom: 10px;
  }

  .hero-text h1 {
    font-size: 40px;
  }
}

.home-product-card {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.home-product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
}

.product-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  padding: 20px;
}

.product-modal {
  position: relative;
  width: min(760px, 100%);
  background: white;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
}

.product-modal-image-wrap {
  flex: 1;
  min-height: 300px;
  background: #f7f7f7;
}

.product-modal-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-modal-content {
  flex: 1;
  padding: 30px 28px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.product-modal-label {
  margin: 0 0 10px;
  color: #667eea;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 12px;
  font-weight: 700;
}

.product-modal-content h3 {
  margin: 0 0 12px;
  color: #222;
  font-size: 32px;
}

.product-modal-price {
  margin: 0 0 14px;
  color: #667eea;
  font-size: 28px;
  font-weight: 700;
}

.product-modal-description {
  margin: 0 0 22px;
  color: #555;
  line-height: 1.7;
}

.product-modal-button {
  width: 100%;
}

.close-product-modal {
  position: absolute;
  top: 15px;
  right: 15px;
  border: none;
  background: rgba(255, 255, 255, 0.9);
  color: #333;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
  z-index: 1;
}

@media (max-width: 767px) {
  .product-modal {
    flex-direction: column;
  }

  .product-modal-image-wrap {
    min-height: 220px;
  }

  .product-modal-content h3 {
    font-size: 24px;
  }
}

