<!-- breadcrumb-section -->
<div class="breadcrumb-section breadcrumb-bg">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 offset-lg-2 text-center">
        <div class="breadcrumb-text">
          <p>Manage Your Inventory</p>
          <h1>Admin Dashboard</h1>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- end breadcrumb section -->

<div class="dashboard-container">
  <div class="container">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
      <div class="header-content">
        <h2>Product Management</h2>
        <button class="btn-add-product" (click)="showAddForm = !showAddForm">
          <i class="fas fa-plus"></i> Add New Product
        </button>
      </div>
    </div>

    <!-- Add Product Form -->
    <div class="add-product-form" *ngIf="showAddForm" [@expandCollapse]>
      <div class="form-card">
        <h3>Add New Product</h3>
        <form #f="ngForm" (ngSubmit)="addNewGood(f)">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Product Name</label>
              <input 
                type="text" 
                id="name"
                class="form-control" 
                name="name" 
                ngModel 
                placeholder="Enter product name" 
                required>
            </div>
            <div class="form-group">
              <label for="price">Price</label>
              <input 
                type="number" 
                id="price"
                class="form-control" 
                name="price" 
                ngModel 
                placeholder="Enter price" 
                required>
            </div>
          </div>

          <div class="form-group">
            <label for="image">Product Image</label>
            <input 
              type="file" 
              id="image"
              name="image" 
              accept="image/*" 
              required 
              #image 
              (change)="onImageChange($event)"
              class="form-control-file">
          </div>

          <div class="image-preview" *ngIf="imagePreview">
            <p>Preview:</p>
            <img [src]="imagePreview" alt="Image Preview">
          </div>

          <div class="form-actions">
            <button 
              type="submit" 
              class="btn-submit" 
              [disabled]="f.invalid || !hasImage || isUploading">
              <i class="fas fa-check"></i> {{ isUploading ? 'Uploading...' : 'Add Product' }}
            </button>
            <button 
              type="button" 
              class="btn-cancel" 
              (click)="showAddForm = false">
              <i class="fas fa-times"></i> Cancel
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Products Grid -->
    <div class="products-section">
      <h3 class="section-title">Products ({{ products.length }})</h3>
      
      <div *ngIf="products.length === 0" class="no-products">
        <p>No products available. Add your first product!</p>
      </div>

      <div class="products-grid" *ngIf="products.length > 0">
        <div class="product-card" *ngFor="let product of products">
          <!-- Edit Product Modal -->
          <div class="edit-product-modal" *ngIf="productToEdit?.id === product.id">
            <div class="modal-content">
              <h4>Edit Product</h4>

              <div class="form-group">
                <label for="editProductName">Product Name</label>
                <input
                  id="editProductName"
                  type="text"
                  class="form-control"
                  [(ngModel)]="editProductName"
                  name="editProductName"
                  placeholder="Enter product name">
              </div>

              <div class="form-group">
                <label for="editProductPrice">Price</label>
                <input
                  id="editProductPrice"
                  type="number"
                  class="form-control"
                  [(ngModel)]="editProductPrice"
                  name="editProductPrice"
                  min="0"
                  step="0.01"
                  placeholder="Enter price">
              </div>

              <div class="modal-actions">
                <button class="btn-submit" (click)="saveProductChanges()" [disabled]="isUploading">
                  <i class="fas fa-save"></i> {{ isUploading ? 'Saving...' : 'Save Changes' }}
                </button>
                <button class="btn-cancel" (click)="cancelEditProduct()">
                  <i class="fas fa-times"></i> Cancel
                </button>
              </div>
            </div>
          </div>

          <!-- Edit Image Modal -->
          <div class="edit-image-modal" *ngIf="editingProductId === product.id">
            <div class="modal-content">
              <h4>Change Product Image</h4>
              
              <div class="current-image">
                <p>Current Image:</p>
                <img [src]="editingProductImage || 'assets/img/products/strawberry.jpg'" alt="Current product image">
              </div>

              <div class="form-group">
                <label for="editImage">New Image</label>
                <input 
                  type="file" 
                  id="editImage"
                  accept="image/*" 
                  (change)="onEditImageChange($event)"
                  class="form-control-file">
              </div>

              <div class="image-preview" *ngIf="editImagePreview">
                <p>New Preview:</p>
                <img [src]="editImagePreview" alt="New image preview">
              </div>

              <div class="modal-actions">
                <button 
                  class="btn-submit" 
                  (click)="updateProductImage()"
                  [disabled]="!editImagePreview || isUploading">
                  <i class="fas fa-save"></i> {{ isUploading ? 'Updating...' : 'Update Image' }}
                </button>
                <button 
                  class="btn-cancel" 
                  (click)="cancelEditImage()">
                  <i class="fas fa-times"></i> Cancel
                </button>
              </div>
            </div>
          </div>

          <!-- Product Card Content -->
          <div *ngIf="editingProductId !== product.id && productToEdit?.id !== product.id" class="card-content">
            <div class="product-image">
              <img 
                [src]="product.photoUrl || 'assets/img/products/strawberry.jpg'" 
                alt="{{ product.name }}"
                (error)="$event.target.src = 'assets/img/products/strawberry.jpg'">
            </div>

            <div class="product-info">
              <h4 class="product-name">{{ product.name | titlecase }}</h4>
              <p class="product-price">${{ product.price | number: '1.2-2' }}</p>
            </div>

            <div class="product-actions">
              <button 
                class="btn-edit-product" 
                (click)="startEditProduct(product)"
                title="Edit product details">
                <i class="fas fa-edit"></i> Edit
              </button>
              <button 
                class="btn-edit-image" 
                (click)="startEditImage(product)"
                title="Change product image">
                <i class="fas fa-image"></i> Image
              </button>
              <button 
                class="btn-delete" 
                (click)="deleteProduct(product.id, product.name)"
                title="Delete product">
                <i class="fas fa-trash"></i> Delete
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

