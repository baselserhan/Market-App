import { Component, ElementRef, OnInit, ViewChild } from '@angular/core';
import { NgForm } from '@angular/forms';
import { Router } from '@angular/router';
import { ToastrService } from 'ngx-toastr';
import { Good } from 'src/app/interfaces/good.interface';
import { GoodsService } from 'src/app/services/goods.service';

@Component({
  selector: 'app-goods',
  templateUrl: './goods.component.html',
  styleUrls: ['./goods.component.css']
})
export class GoodsComponent implements OnInit {

  @ViewChild('image') image: ElementRef;
  imagePreview: string | null = null;
  hasImage = false;
  isUploading = false;
  products: any[] = [];
  showAddForm = false;
  editingProductId: string | null = null;
  editingProductImage: string | null = null;
  editImagePreview: string | null = null;
  productToEdit: any = null;
  editProductName = '';
  editProductPrice: number | null = null;

  private defaultProductImages: { [key: string]: string } = {
    avocado: 'assets/img/products/avocado.jpg',
    banana: 'assets/img/products/banana.jpg',
    berry: 'assets/img/products/berry.jpg',
    broccoli: 'assets/img/products/brocolli.jpg',
    carrot: 'assets/img/products/carrots.jpg',
    carrots: 'assets/img/products/carrots.jpg',
    'green apple': 'assets/img/products/green apple.jpg',
    lemon: 'assets/img/products/lemon.jpg',
    mango: 'assets/img/products/mango.jpg',
    strawberry: 'assets/img/products/strawberry.jpg',
    tomato: 'assets/img/products/tomatoe.jpg',
    tomatoe: 'assets/img/products/tomatoe.jpg',
    watermelon: 'assets/img/products/watermelon.jpg'
  };

  constructor(private gs: GoodsService, private router: Router, private toastr: ToastrService) { }

  ngOnInit(): void {
    this.loadProducts();
  }

  getProductImage(product: any): string {
    if (product?.photoUrl) {
      return product.photoUrl;
    }

    const normalizedName = (product?.name || '').trim().toLowerCase();
    if (!normalizedName) {
      return 'assets/img/products/strawberry.jpg';
    }

    const matchKey = Object.keys(this.defaultProductImages).find(key => normalizedName.includes(key));
    return matchKey ? this.defaultProductImages[matchKey] : 'assets/img/products/strawberry.jpg';
  }

  loadProducts(): void {
    this.gs.getAllGoods().subscribe({
      next: (data: any[]) => {
        this.products = data;
      },
      error: (err) => {
        this.toastr.error('Failed to load products');
      }
    });
  }

  onImageChange(event: Event): void {
    const input = event.target as HTMLInputElement;
    if (input.files && input.files[0]) {
      const file = input.files[0];
      
      if (file.size > 2 * 1024 * 1024) {
        this.toastr.error('Image size must be less than 2MB');
        this.hasImage = false;
        return;
      }

      this.hasImage = true;
      const reader = new FileReader();
      reader.onload = () => {
        this.imagePreview = reader.result as string;
      };
      reader.readAsDataURL(file);
    } else {
      this.hasImage = false;
      this.imagePreview = null;
    }
  }

  onEditImageChange(event: Event): void {
    const input = event.target as HTMLInputElement;
    if (input.files && input.files[0]) {
      const file = input.files[0];
      
      if (file.size > 2 * 1024 * 1024) {
        this.toastr.error('Image size must be less than 2MB');
        return;
      }

      const reader = new FileReader();
      reader.onload = () => {
        this.editImagePreview = reader.result as string;
      };
      reader.readAsDataURL(file);
    }
  }

  addNewGood(form: NgForm) {
    const files = (this.image?.nativeElement as HTMLInputElement)?.files;
    const image = files && files[0] ? files[0] : null;

    if (!image) {
      this.toastr.warning('Please select an image for the product');
      return;
    }

    const name = (<Good>form.value).name;
    const price = (<Good>form.value).price;

    this.isUploading = true;
    
    this.compressImage(image, (compressedFile) => {
      this.gs.addNewGood(name, price, compressedFile)
        .then(() => {
          this.isUploading = false;
          this.toastr.success('Product added successfully!');
          form.reset();
          this.imagePreview = null;
          this.hasImage = false;
          this.showAddForm = false;
          this.loadProducts();
        })
        .catch((err) => {
          this.isUploading = false;
          this.toastr.error(err?.message || 'Failed to add the product. Please try again.');
        });
    });
  }

  deleteProduct(productId: string, productName: string): void {
    if (confirm(`Are you sure you want to delete "${productName}"?`)) {
      this.gs.deleteProduct(productId).then(() => {
        this.toastr.success('Product deleted successfully!');
        this.loadProducts();
      }).catch((err) => {
        this.toastr.error('Failed to delete product');
      });
    }
  }

  startEditProduct(product: any): void {
    this.productToEdit = product;
    this.editProductName = product.name || '';
    this.editProductPrice = product.price ?? 0;
  }

  cancelEditProduct(): void {
    this.productToEdit = null;
    this.editProductName = '';
    this.editProductPrice = null;
  }

  saveProductChanges(): void {
    if (!this.productToEdit) {
      return;
    }

    const name = this.editProductName.trim();
    const price = Number(this.editProductPrice);

    if (!name) {
      this.toastr.warning('Product name is required');
      return;
    }

    if (isNaN(price) || price < 0) {
      this.toastr.warning('Please enter a valid product price');
      return;
    }

    this.isUploading = true;

    this.gs.updateProduct(this.productToEdit.id, { name, price })
      .then(() => {
        this.isUploading = false;
        this.toastr.success('Product updated successfully!');
        this.cancelEditProduct();
        this.loadProducts();
      })
      .catch((err) => {
        this.isUploading = false;
        this.toastr.error(err?.message || 'Failed to update product');
      });
  }

  startEditImage(product: any): void {
    this.editingProductId = product.id;
    this.editingProductImage = product.photoUrl;
    this.editImagePreview = null;
  }

  cancelEditImage(): void {
    this.editingProductId = null;
    this.editingProductImage = null;
    this.editImagePreview = null;
  }

  updateProductImage(): void {
    const files = (document.getElementById('editImage') as HTMLInputElement)?.files;
    const image = files && files[0] ? files[0] : null;

    if (!image) {
      this.toastr.warning('Please select a new image');
      return;
    }

    this.isUploading = true;
    this.compressImage(image, (compressedFile) => {
      this.gs.updateProductImage(this.editingProductId!, compressedFile)
        .then(() => {
          this.isUploading = false;
          this.toastr.success('Product image updated successfully!');
          this.cancelEditImage();
          this.loadProducts();
        })
        .catch((err) => {
          this.isUploading = false;
          this.toastr.error(err?.message || 'Failed to update product image');
        });
    });
  }

  compressImage(file: File, callback: (compressedFile: File) => void): void {
    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onload = (event: any) => {
      const img = new Image();
      img.src = event.target.result;
      img.onload = () => {
        const canvas = document.createElement('canvas');
        let width = img.width;
        let height = img.height;

        if (width > 1200) {
          height = (height * 1200) / width;
          width = 1200;
        }

        canvas.width = width;
        canvas.height = height;

        const ctx = canvas.getContext('2d');
        ctx?.drawImage(img, 0, 0, width, height);

        canvas.toBlob(
          (blob: Blob | null) => {
            if (blob) {
              const compressedFile = new File([blob], file.name, { type: 'image/jpeg' });
              callback(compressedFile);
            }
          },
          'image/jpeg',
          0.7
        );
      };
    };
  }
}
